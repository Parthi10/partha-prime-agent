APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=protecto_prime_agent
DATABASE_USER=protecto
DATABASE_PASSWORD=protecto
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
SKIP_INTEGRATION_TESTS=false
BITBUCKET_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=
WORKSPACE_ROOT=/tmp/protecto-workspaces
GIT_CLONE_TIMEOUT_SECONDS=300
GIT_FETCH_TIMEOUT_SECONDS=300
MAX_WORKSPACE_SIZE_MB=1024
WORKSPACE_RETENTION_HOURS=24
GIT_NETWORK_MAX_RETRIES=3
GIT_NETWORK_RETRY_BACKOFF_SECONDS=0.5

SCANNERS_ENABLED=ruff,bandit,semgrep,pyright,gitleaks,pip-audit
SCANNER_OUTPUT_ROOT=/tmp/protecto-scanner-output
SCANNER_TIMEOUT_SECONDS=120
SCANNER_CPU_SECONDS=90
SCANNER_MEMORY_MB=512
SCANNER_MAX_PROCESSES=32
RUFF_VERSION=0.15.21
BANDIT_VERSION=1.9.4
SEMGREP_VERSION=1.169.0
PYRIGHT_VERSION=1.1.411
GITLEAKS_VERSION=8.30.1
PIP_AUDIT_VERSION=2.10.1
